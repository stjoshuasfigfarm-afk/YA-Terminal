rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global helper: signed in
    function isSignedIn() { return request.auth != null; }
    
    // Global helper: isAdmin (using a trusted collection)
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Catch-all: default deny
    match /silo_prices/{symbol} {
      allow read, write: if true;
    }

    match /vessels/{vesselId} {
      allow read, write: if true;
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    // Default deny at the bottom
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
