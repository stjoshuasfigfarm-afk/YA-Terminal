{
  "entities": {
    "SiloPrice": {
      "title": "SiloPrice",
      "description": "Represents live market price data for a symbol",
      "type": "object",
      "properties": {
        "price": { "type": "number" },
        "changes": { "type": "number" },
        "changesPercentage": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "open": { "type": "number" },
        "previousClose": { "type": "number" },
        "marketCap": { "type": "number" },
        "volume": { "type": "number" },
        "symbol": { "type": "string" },
        "source": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["symbol", "price"]
    }
  },
  "firestore": {
    "silo_prices/{symbol}": {
      "schema": "SiloPrice",
      "description": "Stores live market prices keyed by ticker symbol"
    }
  }
}
