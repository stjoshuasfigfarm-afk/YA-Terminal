{
  "entities": {
    "company": {
      "title": "Company",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "sector": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "country": { "type": "string" },
        "partners": { "type": "array", "items": { "type": "string" } },
        "workforce": { "type": "string" },
        "headquarters": { "type": "string" },
        "domain": { "type": "string" },
        "logo": { "type": "string" }
      },
      "required": ["symbol", "name", "sector", "lat", "lng", "country"]
    }
  },
  "firestore": {
    "/companies/{symbol}": {
      "schema": { "$ref": "#/entities/company" },
      "description": "Store additional company records moved from local configuration."
    }
  }
}
